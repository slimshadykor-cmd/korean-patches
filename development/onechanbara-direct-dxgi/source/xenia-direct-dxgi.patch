+// Onechanbara display bridge development. No game state or driver profile access.
+#pragma once
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace ocb::display {
+enum class FrameState { Idle, Acquired, Submitted, Failed };
+class FrameContract {
+ public:
+  bool Acquire(uint32_t index, uint64_t wait, uint64_t signal) {
+    if (state_ != FrameState::Idle || index >= 3 || !signal ||
+        signal <= wait || signal <= last_signal_) return false;
+    index_ = index; signal_ = signal; state_ = FrameState::Acquired;
+    return true;
+  }
+  bool Submit(uint32_t index) {
+    if (state_ != FrameState::Acquired || index != index_) return false;
+    last_signal_ = signal_; state_ = FrameState::Submitted;
+    return true;
+  }
+  bool Presented() {
+    if (state_ != FrameState::Submitted) return false;
+    state_ = FrameState::Idle; return true;
+  }
+  bool Cancel() {
+    if (state_ != FrameState::Acquired) return false;
+    state_ = FrameState::Idle; return true;
+  }
+  void Fail() { state_ = FrameState::Failed; }
+  FrameState state() const { return state_; }
+ private:
+  FrameState state_ = FrameState::Idle;
+  uint32_t index_ = 0;
+  uint64_t signal_ = 0, last_signal_ = 0;
+};
+
+inline VkImageMemoryBarrier AcquireBarrier(VkImage image, uint32_t family,
+                                           bool initialized) {
+  VkImageMemoryBarrier b{};
+  b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+  b.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT;
+  b.oldLayout = initialized ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED;
+  b.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+  b.dstQueueFamilyIndex = family;
+  b.image = image;
+  b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  return b;
+}
+inline VkImageMemoryBarrier ReleaseBarrier(VkImage image, uint32_t family) {
+  auto b = AcquireBarrier(image, family, true);
+  b.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT;
+  b.dstAccessMask = 0;
+  b.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+  b.srcQueueFamilyIndex = family;
+  b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+  return b;
+}
+}  // namespace ocb::display
