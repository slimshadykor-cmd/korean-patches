+#pragma once
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifdef OCB_DISPLAY_STATIC
+#include "xenia/base/platform_win.h"
+#else
+#include <windows.h>
+#endif
+#include <vulkan/vulkan.h>
+#include <cstdint>
+
+// Development component, NOT a drop-in Xenia plug-in. The caller owns the
+// VkInstance/VkDevice, queue synchronization, image views and command buffers.
+// All calls for one handle run on the same presentation thread. The Xenia GPU
+// emulation thread must not wait on DXGI frame latency.
+#ifdef OCB_DISPLAY_STATIC
+#define OCB_DISPLAY_API
+#elif defined(OCB_DISPLAY_BUILD)
+#define OCB_DISPLAY_API __declspec(dllexport)
+#else
+#define OCB_DISPLAY_API __declspec(dllimport)
+#endif
+
+struct OcbDisplayConfig {
+  VkInstance instance;
+  VkPhysicalDevice physical_device;
+  VkDevice device;
+  VkQueue queue;  // Must be externally synchronized by the caller during Submit.
+  uint32_t queue_family;
+  PFN_vkGetInstanceProcAddr get_instance_proc;
+  PFN_vkGetDeviceProcAddr get_device_proc;
+  HWND window;
+  uint32_t width, height;
+  // VkDevice enabled state cannot be queried after creation. These must be
+  // copied from the actual VkDeviceCreateInfo, not inferred from support.
+  VkBool32 timeline_enabled;
+  bool diagnostics = false;
+  uint32_t enabled_extension_count;
+  const char* const* enabled_extensions;
+};
+struct OcbDisplayAcquireTimings { double latency_ms, allocator_ms; };
+struct OcbDisplayFrame {
+  VkImage image;
+  uint32_t image_index;
+  uint64_t signal_value;  // A stale acquired frame must never be submitted.
+  VkImageMemoryBarrier acquire_barrier;
+  VkImageMemoryBarrier release_barrier;
+};
+enum OcbDisplayResult : int { OCB_ERROR = -1, OCB_OK = 0, OCB_NOT_READY = 1 };
+
+extern "C" {
+OCB_DISPLAY_API void* OcbDisplayCreate(const OcbDisplayConfig*, char* error,
+                                      uint32_t error_capacity);
+// Returns NOT_READY on a bounded DXGI wait, not a fatal initialization error.
+OCB_DISPLAY_API int OcbDisplayAcquire(void*, OcbDisplayFrame*, uint32_t timeout_ms);
+OCB_DISPLAY_API void OcbDisplayGetAcquireTimings(void*, OcbDisplayAcquireTimings*);
+OCB_DISPLAY_API int OcbDisplayGetImages(void*, VkImage* images, uint32_t capacity);
+OCB_DISPLAY_API int OcbDisplayGetSync(void*, const OcbDisplayFrame*,
+    VkSemaphore* semaphore, uint64_t* wait_value, uint64_t* signal_value);
+// Call ONLY after the caller's vkQueueSubmit succeeds. No Vulkan queue lock may
+// be held here: DXGI presentation can wait for the display.
+OCB_DISPLAY_API int OcbDisplayPresentSubmitted(void*, const OcbDisplayFrame*);
+// The command buffer must contain the supplied ownership/layout barriers around
+// its render pass. The pass starts AND ends in COLOR_ATTACHMENT_OPTIMAL.
+// No other vkQueueSubmit or binary present semaphores are used for this frame.
+OCB_DISPLAY_API int OcbDisplaySubmitAndPresent(void*, const OcbDisplayFrame*,
+                                              VkCommandBuffer, VkFence);
+OCB_DISPLAY_API int OcbDisplayCancel(void*);  // Only before SubmitAndPresent.
+OCB_DISPLAY_API const char* OcbDisplayLastError(void*);
+// Caller first destroys its image views/framebuffers after its submitted work
+// completes. Close while the VkDevice is still alive. No driver settings exist.
+OCB_DISPLAY_API void OcbDisplayDestroy(void*);
+}
